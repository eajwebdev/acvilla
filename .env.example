APP_NAME="AC Villa & Private Resort"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila
DEMO=false
BOOKING_HOLD_MINUTES=15
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
PAYMENT_PUBLIC_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eaj_booking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Guest booking emails (request received, downpayment needed, receipt received, confirmed...).
# "log" only writes them to storage/logs/laravel.log. To really send them, use SMTP, e.g. Gmail:
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords (16 letters).
#   3. Fill in below, then run: php artisan config:clear
#      MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#      MAIL_USERNAME=yourname@gmail.com  MAIL_PASSWORD="abcd efgh ijkl mnop"  MAIL_FROM_ADDRESS=yourname@gmail.com
# Hosting email (Hostinger, cPanel...) works the same with its SMTP host, port 465 and MAIL_SCHEME=smtps.
# Test it in Admin > Settings > Messages > "Send test to me".
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Operations: nightly backups kept in storage/app/backups (copy them off this server too).
BACKUP_KEEP=14
# BACKUP_MYSQLDUMP=mysqldump
MAIL_TIMEOUT=10

# Owner login created by AcVillaSeeder (set on each install)
ACVILLA_ADMIN_EMAIL=
ACVILLA_ADMIN_PASSWORD=

# Guests need an account to book (true). Google sign-in: console.cloud.google.com > Credentials > OAuth client ID (Web),
# redirect URI https://<your domain>/auth/google/callback. Until both are set, guests sign up with email instead.
REQUIRE_GUEST_LOGIN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorised redirect URI in the Google console exactly, e.g. https://acvilla.ph/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
