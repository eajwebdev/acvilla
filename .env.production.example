# AC Villa: production settings. Copy to .env on the server and fill in every CHANGE_ME.
# Then run: php artisan app:production-check   (it must say "All checks passed")
# and php artisan platform:health (no failures) before taking real bookings.

APP_NAME="AC Villa & Private Resort"
APP_ENV=production
APP_KEY=
# Never true on the live site: error pages would show code and passwords.
APP_DEBUG=false
APP_URL=https://CHANGE_ME.ph
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Demo logins are refused in production anyway; keep this false.
DEMO=false
SITE_TENANT=ac-villa
BOOKING_HOLD_MINUTES=15
# "mock" does not collect money: guests pay by GCash/InstaPay/bank and staff verify the receipt.
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
PAYMENT_PUBLIC_KEY=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
# A long random password used only by this site, not the hosting account's password.
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SESSION_PATH=/
SESSION_DOMAIN=null

# Behind Cloudflare or a load balancer only: TRUSTED_PROXIES=* (otherwise leave empty).
TRUSTED_PROXIES=

# The owner login created by "php artisan db:seed --class=AcVillaSeeder". Use a strong, unique password
# (12+ characters), sign in once, then you may remove these two lines.
ACVILLA_ADMIN_EMAIL=CHANGE_ME
ACVILLA_ADMIN_PASSWORD=CHANGE_ME
ACVILLA_EMAIL=CHANGE_ME
ACVILLA_PHONE="0927 493 1583"

# Guests need an account to book. Google sign-in: add https://CHANGE_ME.ph/auth/google/callback as an
# Authorised redirect URI of the OAuth client in console.cloud.google.com.
REQUIRE_GUEST_LOGIN=true
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://CHANGE_ME.ph/auth/google/callback

# Booking emails to guests. Gmail: an App Password (myaccount.google.com/apppasswords).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"

# Nightly backups land in storage/app/backups; copy them off this server too.
BACKUP_KEEP=14
# BACKUP_MYSQLDUMP=/usr/bin/mysqldump
